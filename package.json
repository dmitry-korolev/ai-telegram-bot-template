{
  "name": "ai-telegram-bot-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Docker-ready TypeScript template for AI-powered Telegram bots built with grammY.",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/main.ts",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "format": "node node_modules/eslint/bin/eslint.js . --fix",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.36.1",
    "openai": "^5.8.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.53.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.14",
    "eslint": "^9.30.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
